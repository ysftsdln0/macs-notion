# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/collab/node_modules

# prisma generate çıktısı: her `pnpm prisma generate` bu dosyaları yeniden
# yazıyor ve commit'li oldukları için her geliştiricinin ağacını kirletiyordu.
# collab imajı build sırasında kendi `prisma generate`'ini çalıştırır
# (collab/Dockerfile), depoda tutulmasına gerek yok.
/collab/generated/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling (never committed)
.claude/
.superpowers/

# next dev generates these on every start (generate-agent-files.js);
# neither is meant to be committed, they'd dirty every contributor's tree
/AGENTS.md
/CLAUDE.md
