generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator collab_client {
  provider = "prisma-client-js"
  output   = "../collab/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPERADMIN
  ADMIN
  MEMBER
}

enum Permission {
  CONTENT_READ_ALL
  CONTENT_WRITE_ALL
  BUDGET_READ_ALL
  BUDGET_WRITE_ALL
  MEMBER_MANAGE
  INVITE_MANAGE
  CHANNEL_CREATE
  CHANNEL_MANAGE_ALL
  TRASH_MANAGE
}

enum ChannelRole {
  LEAD
  MEMBER
}

enum ChannelVisibility {
  OPEN
  PRIVATE
}

enum DocumentVisibility {
  PUBLIC
  CHANNEL
  PRIVATE
}

enum SharePermission {
  VIEW
  EDIT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

enum SponsorStatus {
  PROSPECT
  CONTACTED
  NEGOTIATING
  SIGNED
  DECLINED
}

enum Currency {
  TRY
  USD
  EUR
}

enum BudgetKind {
  INCOME
  EXPENSE
}

enum BudgetStatus {
  PLANNED
  COMMITTED
  PAID
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String?    @unique
  // Auth.js'in adaptör sözleşmesi bu alanları TAM olarak bu adlarla bekler
  // (@auth/core createUser çağrısı `{ ...profile, emailVerified: null }`
  // gönderir, @auth/prisma-adapter bunu doğrudan `prisma.user.create`'e
  // geçirir). Önceden ayrı bir `avatarUrl` alanı vardı; adaptörün yazdığı
  // `image` ile aynı anlama gelen iki alan tutmak yerine tek alanda birleşti.
  emailVerified DateTime?
  image         String?
  title         String?
  globalRole  GlobalRole @default(MEMBER)
  isActive    Boolean  @default(true)
  onboardedAt DateTime?
  joinedAt    DateTime @default(now())

  accounts       Account[]
  sessions       Session[]
  memberships    ChannelMember[]
  createdChannels Channel[]      @relation("ChannelCreatedBy")
  createdInvites Invite[]        @relation("InviteCreatedBy")
  usedInvites    Invite[]        @relation("InviteUsedBy")
  activities     Activity[]
  documents      Document[]      @relation("DocumentCreatedBy")
  documentShares DocumentShare[]
  comments       Comment[]
  notifications  Notification[]
  notificationActor Notification[] @relation("NotificationActor")
  assignments    Assignee[]
  createdTasks   Task[]          @relation("TaskCreatedBy")
  createdEvents  Event[]         @relation("EventCreatedBy")
  ownedSponsors   Sponsor[]      @relation("SponsorOwner")
  createdSponsors Sponsor[]      @relation("SponsorCreatedBy")
  createdBudgetEntries BudgetEntry[] @relation("BudgetCreatedBy")
  uploads         Attachment[]
  roles          UserRole[]
  grantedRoles   UserRole[]      @relation("RoleGrantedBy")

  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  color       String?
  description String?
  visibility  ChannelVisibility @default(OPEN)
  createdById String
  createdAt   DateTime @default(now())
  archivedAt  DateTime?

  createdBy User            @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  members   ChannelMember[]
  invites   Invite[]
  documents Document[]
  tasks     Task[]
  events    Event[]
  sponsors  Sponsor[]
  budgetEntries BudgetEntry[]

  @@index([archivedAt])
}

model ChannelMember {
  id          String      @id @default(cuid())
  channelId   String
  userId      String
  channelRole ChannelRole @default(MEMBER)
  joinedAt    DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Invite {
  id          String      @id @default(cuid())
  tokenHash   String      @unique
  globalRole  GlobalRole  @default(MEMBER)
  channelId   String?
  channelRole ChannelRole @default(MEMBER)
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime    @default(now())
  // Kalıcı kullanımdan (usedAt) AYRI bir alan: signIn callback'i daveti
  // createUser'dan ÖNCE, kısa bir TTL için burada rezerve eder. createUser
  // (adaptör hatası, ağ kopması, kullanıcının Google ekranında vazgeçmesi
  // gibi) hiç tamamlanmazsa rezervasyon TTL sonunda kendiliğinden serbest
  // kalır — davet kalıcı olarak yanmaz. Bkz. invite-service.ts.
  reservedAt  DateTime?
  usedByUserId String?
  usedAt      DateTime?
  revokedAt   DateTime?

  channel    Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy     User?    @relation("InviteUsedBy", fields: [usedByUserId], references: [id])

  @@index([expiresAt])
}

model Document {
  id          String   @id @default(cuid())
  title       String   @default("")
  icon        String?
  parentId    String?
  channelId   String
  visibility  DocumentVisibility @default(PUBLIC)
  // ydoc'tan çıkarılan düz metin; arama bu kolondan yapılır.
  // (tsvector kolonu şemada yoktur — migration'a elle eklenir.)
  searchText  String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  parent   Document?        @relation("DocTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Document[]       @relation("DocTree")
  channel  Channel          @relation(fields: [channelId], references: [id])
  createdBy User            @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  state    DocState?
  shares   DocumentShare[]

  @@index([archivedAt])
  @@index([channelId])
  @@index([parentId])
}

model DocState {
  documentId String   @id
  ydoc       Bytes
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentShare {
  id         String           @id @default(cuid())
  documentId String
  userId     String
  permission SharePermission  @default(VIEW)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  notes       String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  // Lexorank sıra anahtarı (src/lib/rank.ts). Sözlük sırasına göre
  // sıralanır; iki kart arasına her zaman yeni bir anahtar sığar.
  rank        String       @default("h")
  channelId   String
  eventId     String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  channel   Channel    @relation(fields: [channelId], references: [id])
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignees Assignee[]

  @@index([status, rank])
  @@index([channelId])
  @@index([eventId])
  @@index([archivedAt])
}

model Assignee {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  status      EventStatus @default(PLANNED)
  channelId   String
  coverUrl    String?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  archivedAt  DateTime?

  channel   Channel  @relation(fields: [channelId], references: [id])
  createdBy User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  tasks     Task[]
  sponsors  Sponsor[]
  budgetEntries BudgetEntry[]

  @@index([startsAt])
  @@index([channelId])
  @@index([archivedAt])
}

model Sponsor {
  id           String        @id @default(cuid())
  name         String
  logoUrl      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       SponsorStatus @default(PROSPECT)
  amount       Decimal?      @db.Decimal(12, 2)
  currency     Currency      @default(TRY)
  eventId      String?
  ownerUserId  String?
  channelId    String
  notes        String?
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?

  channel   Channel  @relation(fields: [channelId], references: [id])
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owner     User?    @relation("SponsorOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy User     @relation("SponsorCreatedBy", fields: [createdById], references: [id])
  budgetEntries BudgetEntry[]

  @@index([status])
  @@index([channelId])
  @@index([eventId])
  @@index([archivedAt])
}

model BudgetEntry {
  id          String        @id @default(cuid())
  kind        BudgetKind
  title       String
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency      @default(TRY)
  category    String // 'kongre', 'ulasim', 'sponsor-geliri' vb.
  date        DateTime      @default(now())
  status      BudgetStatus  @default(PLANNED)
  eventId     String?
  sponsorId   String?
  channelId   String
  receiptAttachmentId String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  channel  Channel  @relation(fields: [channelId], references: [id])
  event    Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sponsor  Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  createdBy User     @relation("BudgetCreatedBy", fields: [createdById], references: [id])

  @@index([kind, status])
  @@index([eventId])
  @@index([channelId])
  @@index([archivedAt])
}

// Yükleme dizinindeki dosyanın kaydı. `storagePath` asla istemciye
// dönmez — dosya yalnızca `id` üzerinden, yetki kontrollü route'tan
// servis edilir (src/app/api/files/[id]/route.ts).
model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  mime         String
  size         Int
  storagePath  String   @unique
  entityType   String
  entityId     String
  uploadedById String
  createdAt    DateTime @default(now())

  uploader User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

// Polimorfik: entityType + entityId (Document | Task | Event | Sponsor | BudgetEntry).
// FK yoktur — bütünlüğü uygulama katmanı doğrular (tasarım kararı).
model Comment {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  body       String
  authorId   String
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  deletedAt  DateTime?

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  kind       String    // 'task.assigned' | 'comment' | 'mention' | 'event.link'
  entityType String
  entityId   String
  actorId    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model Activity {
  id         String   @id @default(cuid())
  actorId    String
  verb       String
  entityType String
  entityId   String
  meta       Json?
  channelId  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([channelId])
}

// Kulüp geneli kademe: "hangi koordinatörlüktesin" sorusunu ChannelMember
// cevaplar, "kulüpte hangi yetkilerdesin" sorusunu bu tablo cevaplar.
// İzin KATALOĞU koddadır (Permission enum); ayarlanabilir olan, rolün hangi
// izinleri taşıdığıdır. Kodda kontrol edilmeyen bir izin yalandır.
model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  color       String?
  permissions Permission[]
  isSystem    Boolean      @default(false)
  // Yalnızca rozet sıralaması için. Yetki hiyerarşisi DEĞİL — rol
  // düzenleyebilen tek aktör (SUPERADMIN) zaten her izne sahip. Unique
  // DEĞİL: sabit pozisyonlu sistem rolü eklemeyi engelliyor ve sıralamayı
  // değiştiren bir arayüz olmadığı için hiçbir şey korumuyordu.
  position    Int
  createdAt   DateTime     @default(now())

  members UserRole[]
}

model UserRole {
  id          String   @id @default(cuid())
  userId      String
  roleId      String
  grantedById String?
  grantedAt   DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
}
