# Yerel geliştirme (pnpm dev / pnpm test). Port 5433, bu makinede başka bir
# projenin Postgres'iyle (5432) çakışmaması için compose.dev.yml'de özel
# seçildi — bkz. compose.dev.yml.
DATABASE_URL=postgresql://macs:macs@localhost:5433/macs
AUTH_SECRET=
AUTH_URL=http://localhost:3100
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Production (compose.yml, sunucudaki gerçek .env dosyasında doldurulur) ---

# db servisinin Postgres şifresi. Üretmek için: openssl rand -base64 24
POSTGRES_PASSWORD=

# Caddy'nin otomatik TLS sertifikası çıkaracağı gerçek alan adı; DNS A/AAAA
# kaydı bu sunucunun IP'sini göstermelidir.
DOMAIN=ornek-domain.com

# GHCR imajlarının yayınlandığı GitHub kullanıcı/organizasyon adı
# (ghcr.io/<GH_OWNER>/macs-web). deploy.yml aynı değeri CI içinde
# github.repository_owner'dan otomatik türetir; burası yalnızca VPS'teki
# compose.yml'in aynı imajı çözebilmesi içindir.
GH_OWNER=

# Şu an ayakta olan imaj etiketi. deploy.yml her başarılı CI sonrası
# bunu ${{ github.sha }} olarak VPS'e SSH ile geçirip compose'u günceller;
# elle çalıştırıldığında varsayılan olarak son push edilen "latest" imajı
# kullanılır.
IMAGE_TAG=latest
